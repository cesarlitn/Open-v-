# ============================================================================
#  Operation V — environment configuration (EXAMPLE)
#
#  Copy this file to  config/.env  and adjust only what you need.
#  Everything has a sensible local default, so an empty .env also works.
#  NOTE: user credentials (Meta token, LLM API keys) are NOT set here — you
#  enter those in the app's Settings; they are stored in the local database.
# ============================================================================

# --- Server ---
# Port the backend listens on.
PORT=3001

# --- ComfyUI (image generation / upscale) ---
# Force a specific ComfyUI URL. If empty, these ports are auto-probed on 127.0.0.1.
COMFYUI_URL=
COMFYUI_PORTS=8188,8000,8888,7860

# --- Local LLM providers (used by the Compose tag filter) ---
OLLAMA_URL=http://localhost:11434
LMSTUDIO_URL=http://localhost:1234/v1
LLAMACPP_URL=http://localhost:8080/v1

# --- Cloud LLM API base URLs (API KEYS go in Settings, not here) ---
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
OPENAI_API_BASE=https://api.openai.com/v1
DEEPSEEK_API_BASE=https://api.deepseek.com
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta


# --- Visual search (CLIP model, runs in the browser) ---
CLIP_MODEL=Xenova/clip-vit-base-patch16
